rules_version = '2';

// =============================================================================
// Firebase Cloud Storage security rules — College Management System
// -----------------------------------------------------------------------------
// SECURITY MODEL: all class file access is BACKEND-MEDIATED.
//   * Uploads go through the authenticated Express API, which verifies the
//     Firebase ID token AND the caller's PostgreSQL class access, then writes
//     to Storage via the Admin SDK (Admin SDK bypasses these rules).
//   * Downloads are served via short-lived SIGNED URLs generated by the backend
//     only after an authorization check (GET /api/files/:id/download).
//
// Therefore direct client access to the bucket is DENIED for everyone. This is
// the safest posture: it prevents students from overwriting/deleting faculty
// files, prevents cross-class access, and forbids public/anonymous access —
// because clients never touch Storage directly at all.
//
// Deploy:  firebase deploy --only storage        (with this file referenced in
//          firebase.json as { "storage": { "rules": "backend/storage.rules" } })
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // No direct client reads or writes. Access is exclusively via the backend
      // (Admin SDK for writes, signed URLs for reads).
      allow read, write: if false;
    }
  }
}
