{
  "name": "college-management-system-backend",
  "version": "0.1.0-foundation",
  "description": "Backend foundation for the College Management System (Express + PostgreSQL + Firebase Admin). Foundation phase only — no business APIs yet.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "node --check src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrate.js --status",
    "seed": "node src/db/seed.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "college",
    "express",
    "postgresql",
    "firebase-admin"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "mammoth": "^1.12.2",
    "multer": "^2.3.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.13.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
