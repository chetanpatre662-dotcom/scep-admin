# -----------------------------------------------------------------------------
# Backend environment configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# No real secrets belong in this example file or in any source code.
# -----------------------------------------------------------------------------

# ---- Server ----
PORT=5000
NODE_ENV=development

# CORS: allowed frontend origin(s). Comma-separate multiple origins.
# Inspect how you serve the frontend and set the matching origin(s).
#   - python -m http.server 8000      -> http://localhost:8000
#   - VS Code Live Server             -> http://127.0.0.1:5500
#   - npx serve                       -> http://localhost:3000
FRONTEND_URL=http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# ---- PostgreSQL ----
# Preferred: a single connection string (used first if present).
#   Example: postgresql://user:password@localhost:5432/college_cms
DATABASE_URL=

# Fallback: individual connection variables (used when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_cms
DB_USER=postgres
DB_PASSWORD=

# Set to true only when connecting to a managed DB that requires SSL.
DB_SSL=false

# ---- Firebase Admin SDK (service account) ----
# These come from a Firebase service-account JSON (Project settings ->
# Service accounts -> Generate new private key). They are SECRETS — keep them
# only in .env, never in source or in the frontend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key in quotes. Keep the literal \n escapes on one line;
# the app converts them back to real newlines at runtime.
#   Example: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ---- Firebase Cloud Storage ----
# The Storage bucket for class file attachments (notes/papers/assignments/
# projects/message attachments). Use the *.firebasestorage.app bucket name from
# the Firebase console (Storage). Do NOT use the legacy *.appspot.com form.
#   Example: FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# When empty, file uploads are cleanly disabled (503 STORAGE_NOT_ENABLED) — the
# app never falls back to local disk or fake URLs.
FIREBASE_STORAGE_BUCKET=

# ---- Bootstrap Admin (first-admin OTP approval) ----
# Phone number (E.164, e.g. +919876543210) allowed to approve the VERY FIRST
# admin via OTP when NO approved admin exists yet. Once one approved admin
# exists, this bootstrap path is automatically disabled and normal
# approved-admin OTP approval takes over.
#   - Store the real value ONLY in .env (never in source or the frontend).
#   - Leave empty to disable the bootstrap OTP path entirely.
#   Example: BOOTSTRAP_ADMIN_PHONE=+919876543210
BOOTSTRAP_ADMIN_PHONE=

# ---- AI Assistant (Google Gemini) ----
# The Gemini API key is a SECRET. Keep it ONLY here in .env (server-side).
# It is NEVER sent to the frontend, embedded in HTML/JS, or logged.
# Get a key: https://aistudio.google.com/app/apikey
# Leave GEMINI_API_KEY empty to cleanly DISABLE the AI Assistant (the /api/ai
# endpoints will return a friendly "AI is not configured" message instead of
# erroring). All other AI_* values are safe, tunable configuration.
GEMINI_API_KEY=

# Optional overrides (sensible defaults are used when empty):
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# text-embedding-004 outputs 768 dims. If you change the embedding model,
# update GEMINI_EMBEDDING_DIM to the new model's real dimension AND re-run
# document ingestion (the pgvector column dimension must match).
# GEMINI_EMBEDDING_DIM=768
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_RETRIES=2
# AI_MAX_TOOL_TURNS=4       # max Gemini tool-calling round-trips per question
# AI_HISTORY_TURNS=8        # how many prior messages to send as memory
# AI_RAG_TOP_K=6            # max document chunks retrieved per RAG query
